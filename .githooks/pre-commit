#!/usr/bin/env bash
set -euo pipefail

# Game install the csproj compiles against (Flatpak); set VINTAGE_STORY to override.
export VINTAGE_STORY="${VINTAGE_STORY:-$HOME/.local/share/flatpak/app/at.vintagestory.VintageStory/x86_64/stable/active/files/extra/vintagestory}"

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# ── 1. Validate staged JSON files ─────────────────────────────────────────────
echo "[pre-commit] Validating JSON..."
BAD_JSON=0
while IFS= read -r f; do
  if ! python3 -c "import json,sys; json.load(open('$f'))" 2>/dev/null; then
    echo "  INVALID JSON: $f"
    BAD_JSON=1
  fi
done < <(echo "$STAGED" | grep '\.json$' || true)
if [ "$BAD_JSON" -ne 0 ]; then exit 1; fi

# ── 2. Version bump + build — only when Rudiments/ files are staged ───────────
if echo "$STAGED" | grep -q '^Rudiments/'; then
  V_STAGED=$(python3 -c "import json; print(json.load(open('Rudiments/modinfo.json'))['version'])")
  # Compare against main, not HEAD: every commit on a release branch shares one
  # version, which only has to differ from what main last released.
  BASE=""
  for ref in origin/main main; do
    if git rev-parse --verify --quiet "$ref" >/dev/null; then BASE=$ref; break; fi
  done
  if [ -n "$BASE" ]; then
    V_BASE=$(git show "$BASE":Rudiments/modinfo.json 2>/dev/null | python3 -c "import json,sys; print(json.load(sys.stdin)['version'])" 2>/dev/null || echo "0.0.0")
    if [ "$V_STAGED" = "$V_BASE" ]; then
      echo "[pre-commit] ERROR: version not bumped — still $V_STAGED (same as $BASE)"
      echo "[pre-commit] Bump version in Rudiments/modinfo.json"
      exit 1
    fi
  fi
  echo "[pre-commit] Version: $V_STAGED ✓"

  # Compile check only — the shipped DLL is built by CI from this source, not
  # committed, so there is no artifact to stage here.
  echo "[pre-commit] Building (compile check)..."
  dotnet build Rudiments/Rudiments.csproj -c Release --nologo -v minimal
else
  echo "[pre-commit] No Rudiments/ files staged — skipping version check and build."
fi

echo "[pre-commit] Done."
