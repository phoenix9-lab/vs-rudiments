[
  {
    "comment": "Clayworks adds a wet-then-dry greenware stage in front of vanilla clayforming: its own patches/recipes/clayform/*.json redirect every vanilla clayforming recipe's output to a clayworks:*-wet block that must sit for ~8 hours (Transitionable, type Dry) before it dries into the normal game:*-raw item and re-enters the vanilla firing pipeline. That redirect only touches the vanilla recipe files, so porcelain — which ships its own recipes/clayforming/porcelain-*.json rather than reusing the vanilla ones (see porcelain-clay.json) — was never caught by it and always skipped straight from clayforming to raw ware. These entries give porcelain the same wet stage, redirecting each porcelain clayforming recipe to the matching rudiments:*-porcelain-wet block defined in blocktypes/clay/raw/. Those blocks are handbook-excluded by default since they are unreachable without Clayworks; the entries below un-hide and group them once Clayworks is actually present.",
    "file": "rudiments:recipes/clayforming/porcelain-bowl",
    "op": "replace",
    "path": "/output/code",
    "value": "rudiments:bowl-porcelain-wet",
    "dependsOn": [ { "modid": "clayworks" } ]
  },
